# O padrão é simulação: nenhuma mensagem é enviada a clientes ou às APIs.
INTEGRATION_MODE=simulation
HOST=127.0.0.1
PORT=3000
# Vazio: data/simulation.sqlite em simulação; data/ia-comercial.sqlite em live.
DATABASE_PATH=
QUALIFICATION_FILE=qualification.json

# Somente para o modo live; forneça valores secretos nas configurações seguras.
GPT_API_KEY=
GPT_MODEL=gpt-4.1-mini
KOMMO_ACCOUNT_URL=https://suporteexodosaudecom.kommo.com
KOMMO_ACCESS_TOKEN=
KOMMO_CLIENT_SECRET=
KOMMO_INTEGRATION_ID=
APP_PUBLIC_URL=
ADMIN_TOKEN=

# IDs reais da conta, sem suposições. Sem esses valores, a etapa não é alterada.
KOMMO_PIPELINE_ID=
KOMMO_READY_STATUS_ID=
# Campos de TEXTO no lead. Exemplo de estrutura: {"name":123,"whatsapp":456}
KOMMO_FIELD_MAP={}
