{
  "name": "ia-comercial",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --use-env-proxy --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --use-env-proxy --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "package:widget": "node scripts/package-widget.mjs"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "openai": "7.34.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "4.23.15",
    "typescript": "^5.9"
  }
}
